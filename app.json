{
  "expo": {
    "name": "AnimeQuiz",
    "slug": "mobile-animequiz",
    "scheme": "animequiz",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/animequiz-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F18",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sn6team.animequiz",
      "adaptiveIcon": {
        "backgroundColor": "#0C1022",
        "foregroundImage": "./assets/animequiz-mark.png",
        "monochromeImage": "./assets/animequiz-mark.png"
      },
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/animequiz-icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/animequiz-mark.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0C1022"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita ao AnimeQuiz usar a foto escolhida como sua imagem de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ef330d1-cc20-4fc2-99c8-ec210409c626"
      }
    }
  }
}
