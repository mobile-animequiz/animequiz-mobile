{
  "cli": {
    "version": ">= 26.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "current": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://animequiz-api-wst8.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "final": {
      "extends": "current",
      "autoIncrement": true,
      "environment": "preview"
    }
  },
  "submit": {
    "production": {}
  }
}
