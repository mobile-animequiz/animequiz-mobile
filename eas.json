{
  "cli": {
    "version": ">= 26.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_VERSION": "2" }
    },
    "current": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://animequiz-api-wst8.onrender.com",
        "EXPO_PUBLIC_API_VERSION": "1"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
