# Copy this file to `.env.local` and fill in the values.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle.

# Legal pages opened from the "Terms of Service" / "Privacy Policy" links.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# HTTPS API origin, without /auth, /quizzes or a version suffix.
# A physical phone cannot reach your computer through localhost.
# For local Expo Go testing, use the computer's LAN IP, e.g. http://192.168.0.10:8080.
EXPO_PUBLIC_API_URL=https://animequiz-api-wst8.onrender.com

# Initial version (1 or 2). You can switch versions from the Home screen.
# Update the deployed Java API before using V2 question images.
EXPO_PUBLIC_API_VERSION=1
