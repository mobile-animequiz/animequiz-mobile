# Copy this file to `.env.local` and fill in the values.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle.

# Legal pages opened from the "Terms of Service" / "Privacy Policy" links.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Base URL of the Anime Quiz API (used by src/services once the backend is ready).
EXPO_PUBLIC_API_URL=
